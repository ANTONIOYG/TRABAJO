# ==============================================================================
# Variables de entorno para despliegue con Docker Compose en NAS
# Copia este archivo como .env antes de ejecutar docker compose up
# ==============================================================================

# Puerto expuesto en el host para acceder a la aplicación
# En NAS: usa 80 para acceso directo (http://IP-NAS) o cualquier otro libre
APP_PORT=80:3001

# Puerto expuesto para MySQL en el host (evita conflictos con MySQL local)
MYSQL_PORT_EXPOSED=3307

# Credenciales de la base de datos MySQL
MYSQL_ROOT_PASSWORD=worklog_root_password_segura
MYSQL_DATABASE=worklog_pro
MYSQL_USER=worklog_user
MYSQL_PASSWORD=worklog_password_segura

# Configuración de correo SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=antonioyg@gmail.com
SMTP_PASS=tu_contraseña_aplicacion
DEFAULT_RECIPIENT_EMAIL=antonioyg@gmail.com

# Twilio WhatsApp (Opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
WHATSAPP_TO_NUMBER=
