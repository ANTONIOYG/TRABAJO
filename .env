# ==============================================================================
# Variables de entorno para despliegue con Docker Compose
# ==============================================================================

# Puerto expuesto en el host para acceder a la aplicación
APP_PORT=3001

# Puerto expuesto para MySQL en el host (3307 por defecto para evitar choques con MySQL local)
MYSQL_PORT_EXPOSED=3307

# Conexión a la base de datos MySQL (Externa o Local)
MYSQL_ENABLED=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=worklog_root_password_segura
MYSQL_DATABASE=worklog_pro
MYSQL_USER=root
MYSQL_PASSWORD=Avance25
MYSQL_SSL=false

# Configuración de correo SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=antonioyg@gmail.com
SMTP_PASS=tu_contraseña_aplicacion
DEFAULT_RECIPIENT_EMAIL=antonioyg@gmail.com

# Twilio WhatsApp (Opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
WHATSAPP_TO_NUMBER=
